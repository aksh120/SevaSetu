# The translator works with ANY OpenAI-compatible provider.
# Full comparison (incl. which providers never train on your data): docs/ai-provider.md

# ── Groq (translator) ────────────
# Free, no card, contractually never trains on your inputs/outputs.

# Free limits: 1,000 req/day on gpt-oss-120b & qwen3.6-27b, 8,000 tokens/min.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
# Optional: retried once if the main model fails (rate limit, outage).
OPENAI_FALLBACK_MODEL=qwen/qwen3.6-27b
OPENAI_API_KEY=GROQ_API_KEY
